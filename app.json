{
  "expo": {
    "name": "EMS - Smart Expense Tracker",
    "slug": "react-native-ems",
    "scheme": "ems-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ocr.ems"
    },
    "android": {
      "package": "com.ocr.ems",
      "kotlinVersion": "2.1.21",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you select a bill to scan."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "407972d8-9fc7-4085-93cf-7837e2ab8847"
      }
    }
  }
}
